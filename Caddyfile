{$DUCKDNS_HOST} {
    basic_auth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:8000
    }
    handle_path /tiles/* {
        root * /srv/tiles
        file_server
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
