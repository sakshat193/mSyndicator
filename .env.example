DATABASE_URL=postgresql://msynd:msynd@localhost:55432/msynd
# VM: set a random hex password (openssl rand -hex 24); compose passes it to db and services.
# An existing pgdata volume also needs ALTER USER msynd PASSWORD.
POSTGRES_PASSWORD=
NTES_RATE=1.0
ETRAIN_RATE=0.2
MSYND_LIVE=0
RAILRADAR_API_KEY=
N_PARTICLES=10000
K_PATHS=32
F_MINUTES=60
# MMT is the only approved live source; NTES_RATE and ETRAIN_RATE are unused.
MMT_RATE=0.2
# MMT_POLL_BUDGET=5000
# MMT_HARVEST_BUDGET=0
# Replace these placeholders with your DuckDNS hostname and credentials.
DUCKDNS_HOST=${DUCKDNS_HOST}
BASIC_AUTH_USER=${BASIC_AUTH_USER}
BASIC_AUTH_HASH=${BASIC_AUTH_HASH}
DUCKDNS_TOKEN=
BACKUP_REMOTE=
RCLONE_CONFIG_DIR=/data/rclone
